# Copy to .env and fill in what you have. Only ATLASCLOUD_API_KEY is required.
PORT=8787

# ---- LLMs ----
ATLASCLOUD_API_KEY=
# Optional extra providers (see providers.json to add more)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ---- Voice (TTS). Without these the browser's built-in voice is used. ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Any OpenAI-compatible /audio/speech endpoint (OpenAI, Kokoro-FastAPI, etc.)
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ---- Ears (STT). Without these the browser's speech recognition is used (Chrome/Edge). ----
# Any OpenAI-compatible /audio/transcriptions endpoint (OpenAI Whisper, Groq, faster-whisper-server...)
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ---- Photoreal avatar (Simli) ----
SIMLI_API_KEY=
SIMLI_FACE_ID=

# ---- 3D avatar: URL of a .vrm model (or drop a .vrm file onto the page) ----
VRM_URL=

# ---- Phones ----
# Phones only allow camera, mic and call notifications over HTTPS.
# Either put a tunnel in front (see README) or point these at a certificate (e.g. made with mkcert):
HTTPS_CERT=
HTTPS_KEY=
# Contact for push services (required format; Apple rejects placeholder domains)
VAPID_SUBJECT=mailto:you@example.com
